# =============================================================================
# HỌC CÙNG PHÚC K9 — Environment Variables Example (Vercel / Local Dev)
# Copy into Vercel Project Settings -> Environment Variables (never commit real secrets)
# =============================================================================

# Database (Upstash Redis / Vercel KV)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Admin Access Control (REQUIRED in production)
# Comma-separated admin usernames and a strong initial password for @admin (min 8 chars)
ADMIN_USERNAME=admin,thanhphuc
ADMIN_DEFAULT_PASSWORD=ChangeMe-Strong-Admin-Password-2026!

# AI Tutor + Camera Vision Solver (Ưu tiên các nguồn MIỄN PHÍ tốt nhất — đặt ít nhất 1 key, đặt nhiều key để tự xoay tua dự phòng!)
# 1) Khuyên dùng #1 (Free Camera Vision + Tiếng Việt cực chuẩn, không cần Visa): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 2) Khuyên dùng #2 (Free Llama 4 Scout Vision + Text cực nhanh, 1.000-14.400 req/ngày): https://console.groq.com/keys
GROQ_API_KEY=
# 3) Dự phòng miễn phí thêm (1 tỷ token/tháng, cần SĐT): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# 4) Dự phòng thêm: OpenRouter (:free) / NVIDIA NIM / OpenAI
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# File Storage (Vercel Blob for 25MB PDF / library uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Optional Google OAuth Account Linking
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://thanhphuc.vercel.app/api/auth?action=google-callback
APP_ORIGIN=https://thanhphuc.vercel.app

# Optional Feedback Forwarding (Email via Resend / Webhook)
FEEDBACK_EMAIL_TO=doivo250388@gmail.com
# RESEND_API_KEY=re_xxxxxxxxx
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...
